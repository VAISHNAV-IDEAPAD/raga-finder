# OpenAI API Key (Required for live AI queries)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specific OpenAI Model to use (defaults to gpt-4o-mini, supports gpt-4o, gpt-3.5-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini

# Admin Secret Key (Used to log in to the /admin teaching & rule management portal)
# Change this to your private password/passphrase
ADMIN_SECRET_KEY=ragamaster2026

# Optional: Remote Storage / Vercel KV URL (if deploying on Vercel with persistent KV or Redis)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
